<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Skill Spire Academy | Digital Skills Training</title>

  <meta name="description" content="Skill Spire Academy - Learn Digital Skills, Social Media Marketing, AI, Video Editing and more.">
  <meta name="keywords" content="Skill Spire Academy, digital skills, social media marketing, AI, online courses">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f7faff;
      color: #111827;
      line-height: 1.6;
    }

    header {
      background: #ffffff;
      border-bottom: 1px solid #e5e7eb;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .navbar {
      max-width: 1150px;
      margin: auto;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 24px;
      font-weight: 800;
      color: #1261d6;
    }

    .logo span {
      color: #111827;
    }

    nav a {
      text-decoration: none;
      color: #374151;
      margin-left: 22px;
      font-weight: 600;
    }

    nav a:hover {
      color: #1261d6;
    }

    .hero {
      min-height: 620px;
      display: flex;
      align-items: center;
      background: linear-gradient(135deg, #ffffff, #eaf3ff);
      padding: 70px 20px;
    }

    .hero-content {
      max-width: 1150px;
      width: 100%;
      margin: auto;
      text-align: center;
    }

    .badge {
      display: inline-block;
      background: #e5efff;
      color: #1261d6;
      padding: 8px 18px;
      border-radius: 30px;
      font-weight: 700;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: clamp(40px, 7vw, 72px);
      line-height: 1.1;
      margin-bottom: 20px;
    }

    .hero h1 span {
      color: #1261d6;
    }

    .hero p {
      max-width: 700px;
      margin: auto;
      font-size: 19px;
      color: #4b5563;
    }

    .buttons {
      margin-top: 30px;
    }

    .btn {
      display: inline-block;
      text-decoration: none;
      padding: 14px 26px;
      border-radius: 10px;
      font-weight: 700;
      margin: 6px;
      transition: 0.3s;
    }

    .primary {
      background: #1261d6;
      color: white;
    }

    .primary:hover {
      background: #0d4eaf;
      transform: translateY(-2px);
    }

    .secondary {
      border: 2px solid #1261d6;
      color: #1261d6;
      background: white;
    }

    .secondary:hover {
      background: #eef5ff;
    }

    section {
      padding: 80px 20px;
    }

    .container {
      max-width: 1150px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-title h2 {
      font-size: 38px;
      margin-bottom: 10px;
    }

    .section-title p {
      color: #6b7280;
    }

    .courses {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 22px;
    }

    .course {
      background: white;
      padding: 28px;
      border-radius: 16px;
      border: 1px solid #e5e7eb;
      box-shadow: 0 8px 25px rgba(0,0,0,0.05);
      transition: 0.3s;
    }

    .course:hover {
      transform: translateY(-6px);
      border-color: #1261d6;
    }

    .course .icon {
      font-size: 38px;
      margin-bottom: 15px;
    }

    .course h3 {
      margin-bottom: 8px;
      color: #111827;
    }

    .course p {
      color: #6b7280;
      font-size: 15px;
    }

    .about {
      background: #ffffff;
    }

    .about-box {
      max-width: 850px;
      margin: auto;
      text-align: center;
    }

    .about-box p {
      color: #4b5563;
      font-size: 18px;
      margin-bottom: 20px;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-top: 35px;
    }

    .feature {
      background: #f5f9ff;
      padding: 25px;
      border-radius: 14px;
      text-align: center;
    }

    .feature h3 {
      color: #1261d6;
      margin-bottom: 8px;
    }

    .contact {
      background: linear-gradient(135deg, #1261d6, #0b3f91);
      color: white;
      text-align: center;
    }

    .contact h2 {
      font-size: 40px;
      margin-bottom: 15px;
    }

    .contact p {
      font-size: 18px;
      margin-bottom: 25px;
    }

    .whatsapp {
      background: white;
      color: #1261d6;
    }

    footer {
      background: #0b1220;
      color: #cbd5e1;
      text-align: center;
      padding: 25px 20px;
    }

    footer strong {
      color: white;
    }

    @media (max-width: 700px) {
      .navbar {
        flex-direction: column;
        gap: 10px;
      }

      nav a {
        margin: 0 7px;
        font-size: 14px;
      }

      .hero {
        min-height: 550px;
      }

      section {
        padding: 60px 18px;
      }

      .
